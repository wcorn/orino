SPRING_PROFILES_ACTIVE=local

# MySQL container
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=orino
MYSQL_USER=
MYSQL_PASSWORD=

# Spring Boot datasource
MYSQL_HOST=localhost:3306/orino
MYSQL_USERNAME=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Planner Google Calendar/Tasks 연동 (Google Cloud Console에서 발급)
# redirect-uri는 Console 승인 리디렉션 URI와 일치해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/oauth/callback
